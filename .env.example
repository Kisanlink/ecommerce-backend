# Database Configuration
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=your_password
DB_POSTGRES_DBNAME=ecommerce
DB_POSTGRES_SSLMODE=disable
DB_POSTGRES_MAX_CONNS=10
DB_POSTGRES_IDLE_CONNS=5

# S3 Configuration for Image Upload
DB_S3_REGION=us-east-1
DB_S3_BUCKET=your-bucket-name

# Server Configuration
PORT=8080

# Firebase Configuration (place firebase_service_account.json in internal/config/)
FIREBASE_PROJECT_ID=your-project-id

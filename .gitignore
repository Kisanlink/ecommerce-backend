# =============================================================================
# Go Ecommerce Backend - Enhanced .gitignore
# =============================================================================

# =============================================================================
# Go Language Specific
# =============================================================================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
main.exe
server.exe
main
server

# Test binary, built with `go test -c`
*.test

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Go build cache
.cache/

# =============================================================================
# Environment & Configuration Files
# =============================================================================

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Configuration files with sensitive data
config.json
config.yaml
config.yml
*.config.json

# Firebase service account
firebase_service_account.json
firebase-adminsdk-*.json

# Database configuration
database.json
db.json

# =============================================================================
# Testing & Coverage
# =============================================================================

# Code coverage profiles and other test artifacts
coverage.*
*.coverprofile
profile.cov
coverage.html
coverage.xml

# Test results
test-results/
test-output/

# =============================================================================
# Logs & Debugging
# =============================================================================

# Log files
*.log
logs/
log/

# Debug files
debug
*.debug

# =============================================================================
# IDE & Editor Files
# =============================================================================

# VSCode
.vscode/
*.code-workspace

# GoLand/IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================================================
# Operating System Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# Build & Distribution
# =============================================================================

# Build directories
build/
dist/
bin/
out/

# Temporary build files
*.tmp
*.temp

# =============================================================================
# Database & Storage
# =============================================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Database dumps
*.sql
*.dump

# Redis dumps
dump.rdb

# =============================================================================
# Documentation & Assets
# =============================================================================

# Generated documentation
docs/generated/

# Temporary documentation
*.tmp.md
DEPLOYMENT_GUIDE.md
PARAMETERS_REFERENCE.md

# =============================================================================
# Security & Keys
# =============================================================================

# Private keys
*.pem
*.key
*.p12
*.pfx

# Certificates
*.crt
*.cer
*.der

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# =============================================================================
# Cloud & Deployment
# =============================================================================

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# =============================================================================
# Monitoring & Analytics
# =============================================================================

# Prometheus
prometheus_data/

# Grafana
grafana_data/

# =============================================================================
# Backup & Archive
# =============================================================================

# Backup files
*.bak
*.backup
*.old

# Archive files
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# =============================================================================
# Project Specific
# =============================================================================

# Server executable (if generated locally)
server.exe

# Test scripts output
test_*.log
test_*.out

# Performance profiling
*.prof
*.pprof

# Memory dumps
*.mem

# =============================================================================
# Notes
# =============================================================================
# 
# To add more patterns:
# 1. Add them under the appropriate section
# 2. Use comments to explain why they're ignored
# 3. Keep related patterns grouped together
# 4. Use specific patterns when possible (e.g., *.log instead of *)
#
# Common patterns you might need:
# - API keys: *.api_key
# - Local configs: local.config.*
# - User uploads: uploads/
# - Cache directories: cache/
# - Session files: sessions/
#
.clinerules/byterover-rules.md
.kilocode/rules/byterover-rules.md
.roo/rules/byterover-rules.md
.windsurf/rules/byterover-rules.md
.cursor/rules/byterover-rules.mdc
.kiro/steering/byterover-rules.md
.qoder/rules/byterover-rules.md
.augment/rules/byterover-rules.md